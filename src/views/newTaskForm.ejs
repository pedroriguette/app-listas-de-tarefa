<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/assets/index.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>
    <%- include('partials/header') %>
        <div class="card-add-task">
            <button type="button" id="add-task"><i class="bi bi-plus-circle-fill"></i>
                Mais Atividade
            </button>
        </div>
        <div id="card-form">


            <form action="/task/create" method="post" class="post-form">

                <div class="card-name">
                    <label for="name-input">Nome:</label>
                    <input id="name-input" type="text" name="name" placeholder="Nome da Lista">
                </div>
                <div class="cards-task">

                    <div class="card-task">
                        <label for="tasks-input">Atividade:</label>
                        <input id="tasks-input-1" type="text" name="tasks" placeholder="Nome da Ativida">
                    </div>

                </div>


                <div class="btn-group">
                    <button type="submit" class="btn-create">Criar Atividade</button>
                    <a href="/tasks" class="btn-back">Voltar</a>
                </div>
            </form>
        </div>
        <script src="/js/script.js"></script>
</body>

</html>